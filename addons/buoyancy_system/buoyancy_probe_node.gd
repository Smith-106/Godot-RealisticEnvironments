@tool
class_name BuoyancyProbeNode
extends MeshInstance3D
## A physical buoyancy probe: the top of a water column buoyancy_height tall that
## displaces volume when fully submerged. BuoyantBody applies its buoyancy and water
## resistance. Usually generated by BuoyancyProbeVolume; move, delete or duplicate it
## freely. Shown as a sphere in the editor only.

## Emitted when a setting of the probe changes; its volume refreshes its probe cache.
signal probe_changed

const PROBE_COLOR := Color(0.1, 0.8, 1.0, 0.32)
const DISABLED_PROBE_COLOR := Color(0.25, 0.25, 0.25, 0.12)
const EDITOR_PROBE_RADIUS := 0.16

## Enables this physical probe for buoyancy force sampling.
@export var enabled := true :
	set(value):
		enabled = value
		_update_editor_visuals()
		_emit_probe_changed()

## Water volume (m³) the probe's column displaces when fully submerged.
@export_range(0.001, 100000.0, 0.001, "or_greater", "suffix:m³") var volume := 1.0 :
	set(value):
		volume = maxf(value, 0.001)
		_emit_probe_changed()

## Height of the probe's water column below the node: the probe goes from dry to
## fully submerged over it.
@export_range(0.001, 100.0, 0.001, "or_greater", "suffix:m") var buoyancy_height := 1.0 :
	set(value):
		buoyancy_height = maxf(value, 0.001)
		_emit_probe_changed()

## Multiplies the water drag along the body's forward axis at this probe
## (BuoyantBody.longitudinal_drag_coefficient).
@export_range(0.0, 100.0, 0.01, "or_greater") var longitudinal_drag_multiplier := 1.0 :
	set(value):
		longitudinal_drag_multiplier = maxf(value, 0.0)
		_emit_probe_changed()

## Multiplies the water drag along the body's right axis at this probe
## (BuoyantBody.lateral_drag_coefficient).
@export_range(0.0, 100.0, 0.01, "or_greater") var lateral_drag_multiplier := 1.0 :
	set(value):
		lateral_drag_multiplier = maxf(value, 0.0)
		_emit_probe_changed()

var _material : StandardMaterial3D


func _ready() -> void:
	cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	set_notify_transform(false)
	set_notify_local_transform(Engine.is_editor_hint())
	if Engine.is_editor_hint():
		extra_cull_margin = 10000.0
		_update_editor_visuals()
	else:
		visible = false
		mesh = null
		material_override = null


func _notification(what: int) -> void:
	if Engine.is_editor_hint() and what == NOTIFICATION_LOCAL_TRANSFORM_CHANGED:
		_emit_probe_changed()


func _update_editor_visuals() -> void:
	if not Engine.is_editor_hint():
		return
	if mesh == null or not (mesh is SphereMesh):
		mesh = SphereMesh.new()
	var sphere := mesh as SphereMesh
	sphere.radius = EDITOR_PROBE_RADIUS
	sphere.height = EDITOR_PROBE_RADIUS * 2.0
	if _material == null:
		_material = StandardMaterial3D.new()
		_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_material.no_depth_test = true
		_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	_material.albedo_color = PROBE_COLOR if enabled else DISABLED_PROBE_COLOR
	material_override = _material


func _emit_probe_changed() -> void:
	if is_inside_tree():
		probe_changed.emit()
